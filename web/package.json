{
  "name": "threeway-interface",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-manifest.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check:export": "node scripts/check-export.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.90.21",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "2.46.3",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@types/node": "22.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "playwright": "1.58.2",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
